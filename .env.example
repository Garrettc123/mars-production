# MARS API — required environment variables
# Copy this file to .env and fill in real values before running.

# Anthropic API key — used by MARS to call Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Secret key clients must supply in the X-Api-Key header
MARS_API_KEY=your_mars_api_key_here

# NWU Protocol internal agent token (required for /nwu-listener)
INTERNAL_AGENT_TOKEN=your_internal_agent_token_here

# Port the server listens on (default: 8000)
PORT=8000

# Routing (v1.1)
MARS_STANDARD_MODEL=claude-3-5-haiku-20241022
MARS_DEEP_MODEL=claude-3-5-sonnet-20241022
MARS_THRESHOLD=0.50
MARS_DEFAULT_ROUTE=auto
MARS_STANDARD_MAX_TOKENS=1200
MARS_DEEP_MAX_TOKENS=4096
